# Environment Variables Template untuk Production
# INSTRUKSI: Copy file ini ke .env.production dan isi dengan values sebenarnya

# ============================================
# SUPABASE CONFIGURATION
# ============================================
# Get from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# ============================================
# ENCRYPTION KEY
# ============================================
# Generate dengan command: openssl rand -hex 32
LLM_ENCRYPTION_KEY=your_32_byte_hex_encryption_key_here

# ============================================
# APPLICATION SETTINGS
# ============================================
PORT=3000
NODE_ENV=production

# ============================================
# SETUP INSTRUCTIONS
# ============================================
# 1. Copy file ini:
#    cp env.production.example .env.production
#
# 2. Fill actual values untuk:
#    - NEXT_PUBLIC_SUPABASE_URL (dari Supabase dashboard)
#    - NEXT_PUBLIC_SUPABASE_ANON_KEY (dari Supabase dashboard)
#    - LLM_ENCRYPTION_KEY (generate dengan: openssl rand -hex 32)
#
# 3. JANGAN commit .env.production ke git!
#    (sudah ada di .gitignore)
